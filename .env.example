# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=IDRAKIYA
DEBUG=false
# Local dev:
ALLOWED_ORIGINS=["http://localhost:3000"]
# Production (Render): set to your Vercel URL, e.g.:
# ALLOWED_ORIGINS=["https://idrakiya.vercel.app"]

# ── Database ───────────────────────────────────────────────────────────────────
# Local:
DATABASE_URL=postgresql+asyncpg://idrakiya:idrakiya_secret@localhost:5432/idrakiya
# Supabase (production) — replace postgresql:// with postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change_me_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Uploads ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=media
MAX_UPLOAD_SIZE_MB=500
